flowchart TB
    %% 1. Power Supply
    subgraph POWER["1. DC SOURCE"]
        A["4 Batteries<br>(Split ±9V Rails)"]
    end

    %% 2. Oscillator
    subgraph SIGNAL_GEN["2. AC SOURCE"]
        B["Wien Bridge Oscillator"] --> C["16V Vpp Sine Wave"]
    end

    %% 3. Idealization
    subgraph COND["3. SIGNAL IDEALIZATION"]
        D["Voltage Divider<br>(900mV Vpp)"]
    end

    %% 4. Sensor & Amp Stage - OKLAR BURADA DÜZELTİLDİ
    subgraph SENSOR_AMP["4. SENSOR & AMPLIFIER STAGE"]
        direction LR
        %% Kutuları yan yana dizerek okları kısalttık
        E["Capacitive Sensor<br>(100pF - 250pF)"] --> F["NPN Amplifier"]
        
        %% Kazanç dallanması (Oklar artık birbirine girmez)
        F --> G1["Min Case:<br>4.4 Gain (4.0V Vpp)"]
        F --> G2["Max Case:<br>5.0 Gain (4.5V Vpp)"]
        
        G1 --> G_OUT{Output}
        G2 --> G_OUT
    end

    %% 5. Output Processing
    subgraph OUTPUT_SEC["5. AC TO DC"]
        H["Half-Wave Rectifier<br>& Filter"] --> I["1.6V - 2.0V DC Output"]
    end

    %% Ana Akış Bağlantıları
    A --> B
    C --> D
    D --> E
    G_OUT --> H

    %% Görsel Stil Ayarları
    style E fill:#fff9c4,stroke:#fbc02d,stroke-width:1px
    style G_OUT fill:#fff9c4,stroke:#fbc02d,stroke-width:1px
    style I font-weight:bold,fill:#fffde7,stroke:#fbc02d
    style POWER fill:#fdfdfd,stroke:#333,stroke-width:2px
    style SENSOR_AMP fill:#e1f5fe,stroke:#01579b,stroke-width:2px
    style OUTPUT_SEC fill:#e8f5e9,stroke:#2e7d32,stroke-width:2px
